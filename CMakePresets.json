{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "firmware-debug",
      "displayName": "Firmware (Debug)",
      "description": "STM32 firmware Debug build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "firmware-debug",
      "configurePreset": "firmware-debug"
    }
  ],
  "testPresets": []
}
